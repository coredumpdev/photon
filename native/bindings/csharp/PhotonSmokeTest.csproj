<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the generated binding together with the smoke test, so that one
    `dotnet run` tells you whether the P/Invoke layer is correct on this
    platform. It is not a NuGet package and is not meant to be one — packaging
    is a decision for whoever ships a Photon control.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PhotonSmokeTest</AssemblyName>
    <RootNamespace>Photon</RootNamespace>
    <!-- The generated file is auto-generated; do not warn about its style. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
